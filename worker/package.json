{
  "name": "vibedeck-schema",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "rm -rf public && mkdir -p public && cp -R ../schema/v1 public/v1",
    "dev": "npm run sync && wrangler dev",
    "deploy": "npm run sync && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-schemas.mjs",
    "test": "node scripts/test-routes.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
